{
  "name": "go-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Server for Go: the trip database, the signed socket to Go, and the app API",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen:types": "openapi-typescript contract/go.json -o src/contract/schema.d.ts",
    "migrate": "tsx scripts/migrate.ts",
    "pretest": "node scripts/prepare-test-pg.mjs",
    "dev:stack": "node scripts/prepare-test-pg.mjs && tsx scripts/dev-stack.ts",
    "dev:real": "node scripts/prepare-test-pg.mjs && tsx scripts/dev-real.ts",
    "inspect": "tsx scripts/inspect.ts",
    "dev:auth": "tsx scripts/dev-auth.ts",
    "dev:stack:dev": "node scripts/prepare-test-pg.mjs && tsx scripts/dev-stack.ts --dev-auth",
    "check:supabase": "tsx scripts/check-supabase.ts",
    "dev:login": "tsx scripts/dev-login.ts",
    "supabase:rehearse": "tsx scripts/rehearse-supabase.ts",
    "supabase:token": "tsx scripts/supabase-token.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "puppeteer-core": "25.13.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "embedded-postgres": "18.4.0-beta.17",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.9.1"
}
