{
  "name": "go-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Server for Go: the trip database, the signed socket to Go, and the app API",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen:types": "openapi-typescript contract/go.json -o src/contract/schema.d.ts",
    "migrate": "tsx scripts/migrate.ts",
    "pretest": "node scripts/prepare-test-pg.mjs",
    "dev:stack": "node scripts/prepare-test-pg.mjs && tsx scripts/dev-stack.ts",
    "postman": "pnpm dlx newman@6 run docs/go-server.postman_collection.json -e docs/go-server.postman_environment.json --folder \"Run in order\"",
    "dev:real": "node scripts/prepare-test-pg.mjs && tsx scripts/dev-real.ts",
    "inspect": "tsx scripts/inspect.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "embedded-postgres": "18.4.0-beta.17",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/darwin-arm64",
      "esbuild"
    ]
  }
}
