# The Server for Go. Copy to .env and fill in. Never commit real values.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/go   # Supabase: the project's connection string
GO_URL=https://brain.go.example                               # Go's base URL: no path, no trailing slash
GO_SIGNING_SECRET=                                            # openssl rand -hex 32 (shared with Go by one-time link)
GO_SPEND_PRIVATE_KEY=                                         # PEM from: openssl genpkey -algorithm ed25519  (one line with \n is fine)
INSTANCE_NAME=server-1                                        # one per instance: it makes each socket signature unique
PORT=8080
PUBLIC_BASE_URL=https://go.example                            # the app's address, for invite links: <base>/j/<code>
APP_SESSION_SECRET=                                           # openssl rand -hex 32 (signs the app's sign-in tokens)
APP_ORIGINS=                                                  # the exact addresses of the web app that may call this server from a browser, comma-separated (no wildcard); empty: none
DB_POOL_MAX=30                                                # Postgres connections per instance (the outbox uses at most a third)
VAPID_PUBLIC_KEY=                                             # Web Push keys: npx web-push generate-vapid-keys. All three, or notifications are only logged
VAPID_PRIVATE_KEY=                                            # keep secret. Changing the keys later invalidates every existing browser subscription
VAPID_SUBJECT=                                                # a mailto: or https: address the push services can reach you at, e.g. mailto:ops@example.com
