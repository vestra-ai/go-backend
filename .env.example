# The Server for Go. Copy to .env and fill in. Never commit real values.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/go   # Supabase: the project's connection string
GO_URL=https://brain.go.example                               # Go's base URL: no path, no trailing slash
GO_SIGNING_SECRET=                                            # openssl rand -hex 32 (shared with Go by one-time link)
GO_SPEND_PRIVATE_KEY=                                         # PEM from: openssl genpkey -algorithm ed25519  (one line with \n is fine)
INSTANCE_NAME=server-1                                        # one per instance: it makes each socket signature unique
GO_SERVER_NAME=go-server-dev-yourname                         # one per deployment, the same on every instance and deploy (prod: go-server-prod). Your own: two Servers with one name are taken for one
LOG_GO_TRAFFIC=                                               # 1: write every socket frame to logs/go-traffic.jsonl (no secrets; local only, read by pnpm inspect)
PORT=8080
PUBLIC_BASE_URL=https://go.example                            # the app's address, for invite links: <base>/invite/<code>
APP_SESSION_SECRET=                                           # openssl rand -hex 32 (signs the app's sign-in tokens)
INTERNAL_API_KEY=                                             # openssl rand -hex 32: the App team's key for /internal/v1 (x-internal-key). Empty: those routes answer 404
APP_ORIGINS=                                                  # the exact addresses of the web app that may call this server from a browser, comma-separated (no wildcard); empty: none
DB_POOL_MAX=30                                                # Postgres connections per instance (the outbox uses at most a third)
# Sign-in (docs/SUPABASE-SETUP.md). With SUPABASE_URL set, the app's Supabase access tokens are required (AUTH_MODE=supabase).
AUTH_MODE=                                                    # supabase | dev. Empty: supabase if SUPABASE_URL is set, else dev (dev is refused in production)
SUPABASE_URL=                                                 # https://<ref>.supabase.co: tokens are checked against its published signing keys
SUPABASE_PUBLISHABLE_KEY=                                     # sb_publishable_…: not used by the server; for pnpm check:supabase / dev:login, and the app
SUPABASE_JWT_SECRET=                                          # only for a project still on the legacy shared secret (HS256)
DATABASE_CA_CERT=                                             # path to Supabase's CA certificate (Database settings → SSL), so TLS is verified
# Files (photos, voice notes, ticket PDFs): Supabase Storage, a private bucket, signed upload and download links.
STORAGE=                                                      # supabase | memory. Empty: supabase if SUPABASE_SECRET_KEY is set, else memory (files kept in memory, lost on restart: local only)
SUPABASE_SECRET_KEY=                                          # sb_secret_… (Project Settings → API Keys → secret key): Storage only. On Railway only, never in a laptop's .env
SUPABASE_STORAGE_BUCKET=                                      # the private bucket's name; empty: go-files
# Feature flags served by GET /app/v1/config (1 or 0; unset: the default). Defaults: all off.
GO_CONTRACT=                                                  # 1.0 (default) | 1.1. On 1.0 a re-split expense sends no event (Go 1.0 refuses it; it reads the trip). Set 1.1 when Go ships docs/GO-CHANGES.md
PUPPETEER_EXECUTABLE_PATH=                                     # the Chromium that renders demo e-tickets and vouchers (PDF): /usr/bin/chromium on Railway, your Chrome locally; empty: PDFs off
FEATURE_CHECKIN=
FEATURE_VISA=
FEATURE_CALLS=
FEATURE_VOTE_RETRACT=
FEATURE_VOTE_FLEXIBLE=
FEATURE_CLAIM=
SUPABASE_TEST_EMAIL=                                          # a test user (Supabase → Authentication → Users, Auto Confirm) for pnpm supabase:token, until Google is on
SUPABASE_TEST_PASSWORD=                                       # its password: local only, never in the app or on Railway
