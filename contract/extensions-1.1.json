{
  "contract": "1.3.0+server-checkin",
  "description": "What the Server accepts beyond Go's official contract 1.3.0 (contract/go.json, from vestra-ai/go-brain packages/contract): the web check-in requests, behind the checkin flag. Not yet agreed with Go's team. Laid over the official files additively. (`visible_to_person_ids` on post_message and Message was ours until 1.2 made it official.)",
  "schemas": {
    "GetCheckin": {
      "type": "object",
      "description": "1.1 (GO-CHANGES 3): Server → Go, the state of one person's web check-in on a booking. Go may answer `working` and finish by event or replace_card.",
      "properties": {
        "trip_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "booking_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "person_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "trip_id",
        "booking_id",
        "person_id"
      ]
    },
    "CheckinState": {
      "type": "object",
      "description": "1.1 (GO-CHANGES 3; app contract §4.12). Draft: the field names are the app contract's; the inner shapes are open until Go's team fixes them.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_open",
            "open",
            "working",
            "done",
            "failed",
            "closed"
          ]
        },
        "opens_at": {
          "type": "string",
          "format": "date-time"
        },
        "closes_at": {
          "type": "string",
          "format": "date-time"
        },
        "flight": {
          "type": "object"
        },
        "passenger": {
          "type": "object"
        },
        "digi_yatra": {
          "type": "boolean"
        },
        "declaration": {
          "type": "boolean"
        },
        "seat": {
          "type": "string",
          "maxLength": 8
        },
        "companion": {
          "type": "object"
        },
        "seat_map": {
          "type": "object"
        },
        "boarding_pass": {
          "type": "object"
        }
      },
      "required": [
        "status"
      ]
    },
    "SubmitCheckin": {
      "type": "object",
      "description": "1.1 (GO-CHANGES 3): Server → Go, the person's check-in answers. A paid seat is paid through Go's pay card and the vault; how the seat and paid extras reach Go and how that payment is approved is proposed in GO-CHANGES 6.5 and not built yet.",
      "properties": {
        "trip_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "booking_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "person_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digi_yatra": {
          "type": "boolean"
        },
        "declaration": {
          "type": "boolean"
        },
        "seat": {
          "type": "string",
          "maxLength": 8
        },
        "mobile": {
          "type": "string",
          "maxLength": 20
        }
      },
      "required": [
        "trip_id",
        "booking_id",
        "person_id",
        "digi_yatra",
        "declaration"
      ]
    },
    "SubmitCheckinResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "done",
            "working",
            "failed"
          ]
        },
        "boarding_pass": {
          "type": "object"
        }
      },
      "required": [
        "status"
      ]
    }
  },
  "methods": [
    {
      "name": "get_checkin",
      "direction": "to_go",
      "summary": "1.1: the state of one person's web check-in on a booking. Go may answer working and finish later.",
      "params": "GetCheckin",
      "result": "CheckinState",
      "answer_within_seconds": 2,
      "sends_event": null
    },
    {
      "name": "submit_checkin",
      "direction": "to_go",
      "summary": "1.1: the person's check-in answers (DigiYatra, declaration, seat).",
      "params": "SubmitCheckin",
      "result": "SubmitCheckinResult",
      "answer_within_seconds": 2,
      "sends_event": null
    }
  ]
}
